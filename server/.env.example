PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/visitor_pass_db
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ORG_NAME=Acme Corporation
TIMEZONE=Asia/Kolkata

# Email (optional - if SMTP_HOST is empty, emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Visitor Desk <no-reply@example.com>"

# SMS via Twilio (optional - if empty, SMS is printed to the console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
